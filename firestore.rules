rules_version = '2';
// PSMacc: ข้อมูลแยกตามบริษัท สิทธิ์ owner (เจ้าของ) / editor (ผู้แก้ไข) / viewer (ผู้ดู)
//   companies/{co}                   name, taxId, ownerId (= เจ้าของหลัก), memberIds (ใช้ค้นบริษัทของผู้ใช้)
//   companies/{co}/members/{uid}     { role, email, addedAt, auditId }  role 'removed' = ถูกนำออกแล้ว
//   companies/{co}/audit/{id}        บันทึกการเปลี่ยนสิทธิ์ ล็อก/ปลดล็อกงวด และลบสาขา (สร้างได้อย่างเดียว แก้/ลบไม่ได้)
//   companies/{co}/branches/{code}   สาขา { code, name, address, phone, active, used, createdAt }
//                                    used = มีเอกสารอ้างอิงแล้ว (ตั้งเป็น true ได้ทางเดียว ยกเลิกไม่ได้)
//   documents / taxReturns ที่ลงวันที่ในงวดที่ล็อกแล้ว (settings/company.lockDate) สร้าง/แก้/ลบไม่ได้ ต้องปลดล็อกก่อน
//   companies/{co}/{collection}/{id} ข้อมูลบัญชี (documents, contacts, accounts, settings, ...)
//   ชื่อบริษัท เลขผู้เสียภาษี และข้อมูลนิติบุคคลหลัก (companies/{co} และ settings/company) แก้ได้เฉพาะเจ้าของ
//   invites/{co}__{email}            คำเชิญที่ยังไม่ตอบรับ
//
// เจ้าของหลัก (ownerId) ถูกลดสิทธิ์หรือนำออกไม่ได้ เปลี่ยนได้ทางเดียวคือเจ้าของหลักโอนสิทธิ์ให้สมาชิกอื่น
// ทุกการเปลี่ยนแปลงใน members ต้องมี audit entry ที่ตรงกันใน batch เดียวกัน
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function coPath(co) { return /databases/$(database)/documents/companies/$(co); }
    function memberOf(co, uid) { return /databases/$(database)/documents/companies/$(co)/members/$(uid); }
    function auditPath(co, id) { return /databases/$(database)/documents/companies/$(co)/audit/$(id); }
    function invitePath(co) { return /databases/$(database)/documents/invites/$(co + '__' + myEmail()); }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return request.auth.token.email_verified == true; }
    function roles() { return ['owner', 'editor', 'viewer']; }
    function myRole(co) { return get(memberOf(co, request.auth.uid)).data.role; }
    function isMember(co) { return signedIn() && exists(memberOf(co, request.auth.uid)) && myRole(co) in roles(); }
    function canEdit(co) { return isMember(co) && myRole(co) in ['owner', 'editor']; }
    function isOwner(co) { return isMember(co) && myRole(co) == 'owner'; }
    function primaryOwner(co) { return get(coPath(co)).data.ownerId; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // ข้อมูลนิติบุคคลหลักใน settings/company: แก้ได้เฉพาะเจ้าของ (Owner/Admin)
    // ฟิลด์อื่น (ที่อยู่บนเอกสาร โทร อีเมล โลโก้ ข้อมูลติดต่อ ค่าเริ่มต้น สาขา) ผู้แก้ไขแก้ได้
    function legalFields() { return ['name', 'legalName', 'taxId', 'businessType', 'legalAddress', 'vatRegistered', 'fiscalStart']; }
    function touchesLegal(coll, id) {
      return coll == 'settings' && id == 'company'
        && (request.method == 'delete' || request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasAny(legalFields()));
    }

    // งวดบัญชี (settings/company.lockDate): ผู้แก้ไขล็อกได้ (เลื่อนไปข้างหน้า) ปลดล็อกได้เฉพาะเจ้าของ
    // ทุกการเปลี่ยน lockDate ต้องมี audit 'period_lock' / 'period_unlock' ใน batch เดียวกัน
    function settingsCompany(co) { return /databases/$(database)/documents/companies/$(co)/settings/company; }
    function lockOf(r) { return r == null ? '' : r.data.get('lockDate', ''); }
    function lockChanged(coll, id) {
      return coll == 'settings' && id == 'company'
        && (request.method == 'delete' ? lockOf(resource) != '' : request.resource.data.get('lockDate', '') != lockOf(resource));
    }
    function lockWriteOk(co) {
      return request.method != 'delete'
        && request.resource.data.get('lockAuditId', '') != (resource == null ? '' : resource.data.get('lockAuditId', ''))
        && !exists(auditPath(co, request.resource.data.lockAuditId))
        && existsAfter(auditPath(co, request.resource.data.lockAuditId));
    }
    function validLockAudit(co, id, a) {
      let s = settingsCompany(co);
      let before = exists(s) ? get(s).data.get('lockDate', '') : '';
      let after = getAfter(s).data;
      return canEdit(co) && after.get('lockAuditId', '') == id
        && a.fromDate == before && a.toDate == after.get('lockDate', '')
        && (a.action == 'period_lock' ? a.toDate > a.fromDate : (isOwner(co) && a.toDate < a.fromDate));
    }

    // ---- งวดที่ล็อกแล้ว: ห้ามสร้าง/แก้/ลบ transaction ที่ลงวันที่ในงวดนั้น (ทุกบทบาท รวมถึงเจ้าของ ต้องปลดล็อกก่อน) ----
    // ใช้ค่า lockDate หลัง batch (ล็อกพร้อมแก้รายการใน batch เดียวกันไม่ได้; ปลดล็อกแล้วค่อยแก้)
    function lockNow(co) { let s = settingsCompany(co); return existsAfter(s) ? getAfter(s).data.get('lockDate', '') : ''; }
    function inOpen(d, lock) { return lock == '' || (d is string && d > lock); }
    // วันที่ที่ใช้ตัดสินงวด: เอกสาร = date, แบบ ภ.พ.30 = วันที่ 1 ของเดือน (period)
    function txDate(coll, r) { return coll == 'taxReturns' ? r.data.get('period', '') + '-01' : r.data.get('date', ''); }
    function pDate(p) { return p is map ? p.get('date', '') : ''; }
    // ทุกรายการชำระในลิสต์ต้องอยู่ในงวดที่เปิด (ตรวจได้สูงสุด 10 รายการต่อการเขียนหนึ่งครั้ง)
    function allOpen(l, lock) {
      return lock == '' || (l.size() <= 10
        && (l.size() < 1 || inOpen(pDate(l[0]), lock)) && (l.size() < 2 || inOpen(pDate(l[1]), lock))
        && (l.size() < 3 || inOpen(pDate(l[2]), lock)) && (l.size() < 4 || inOpen(pDate(l[3]), lock))
        && (l.size() < 5 || inOpen(pDate(l[4]), lock)) && (l.size() < 6 || inOpen(pDate(l[5]), lock))
        && (l.size() < 7 || inOpen(pDate(l[6]), lock)) && (l.size() < 8 || inOpen(pDate(l[7]), lock))
        && (l.size() < 9 || inOpen(pDate(l[8]), lock)) && (l.size() < 10 || inOpen(pDate(l[9]), lock)));
    }
    function pays(r) { let p = r.data.get('payments', []); return p is list ? p : []; }
    // การชำระที่เพิ่มหรือลบในครั้งนี้ต้องลงวันที่ในงวดที่เปิด; paidDate เดิม/ใหม่ต้องอยู่ในงวดที่เปิด (ถ้าเปลี่ยน)
    function paymentsOk(lock) {
      let o = pays(resource); let n = pays(request.resource);
      let po = resource.data.get('paidDate', null); let pn = request.resource.data.get('paidDate', null);
      return allOpen(n.removeAll(o), lock) && allOpen(o.removeAll(n), lock)
        && (po == pn || ((po == null || po == '' || inOpen(po, lock)) && (pn == null || pn == '' || inOpen(pn, lock))));
    }
    function periodOk(co, coll) {
      let lock = lockNow(co);
      return !(coll in ['documents', 'taxReturns']) || lock == ''
        || (request.method == 'create' && inOpen(txDate(coll, request.resource), lock) && allOpen(pays(request.resource), lock)
            && (request.resource.data.get('paidDate', null) == null || request.resource.data.get('paidDate', null) == '' || inOpen(request.resource.data.get('paidDate', null), lock)))
        || (request.method == 'delete' && inOpen(txDate(coll, resource), lock) && allOpen(pays(resource), lock))
        || (request.method == 'update' && paymentsOk(lock)
            && ((inOpen(txDate(coll, resource), lock) && inOpen(txDate(coll, request.resource), lock))
              // เอกสารในงวดที่ล็อก: แก้ได้เฉพาะการชำระ (ในงวดเปิด) และสถานะการชำระ
              || (txDate(coll, request.resource) == txDate(coll, resource)
                && changed().hasOnly(['payments', 'status', 'paidDate', 'updatedAt']))));
    }

    // สาขา: ลบได้เมื่อมี audit 'branch_delete' ใน batch เดียวกัน; สาขาที่มีประวัติ (used) ลบได้เฉพาะเจ้าของ
    function branchPath(co, code) { return /databases/$(database)/documents/companies/$(co)/branches/$(code); }
    function branchFields() { return ['code', 'name', 'address', 'phone', 'active', 'used', 'createdAt']; }
    function validBranchDeleteAudit(co, id, a) {
      let b = branchPath(co, a.branchCode);
      return exists(b) && !existsAfter(b)
        && id == 'bdel_' + a.branchCode + '_' + string(get(b).data.createdAt)
        && a.branchUsed == get(b).data.get('used', false)
        && (isOwner(co) || (canEdit(co) && get(b).data.get('used', false) == false));
    }
    // เอกสารที่อ้างสาขาใหม่ ต้องทำเครื่องหมาย used ที่สาขานั้นก่อน (หรือพร้อมกันใน batch)
    function branchRef(r) { let ex = r == null ? null : r.data.get('extra', null); return ex is map ? ex.get('branch', null) : null; }
    function docBranchOk(co) {
      let b = branchRef(request.resource);
      return b == null || b == '' || b == '00000' || b == branchRef(resource)
        || (b is string && getAfter(branchPath(co, b)).data.get('used', false) == true);
    }

    // audit entry ต้องตรงกับการเปลี่ยนแปลงจริงของสมาชิกใน batch เดียวกัน
    function validAudit(co, id, a) {
      let t = memberOf(co, a.targetUid);
      let before = exists(t) ? get(t).data.role : 'none';
      let after = getAfter(t).data;
      return after.auditId == id && after.role == a.toRole && after.email == a.targetEmail && before == a.fromRole
        && (
          // สร้างบริษัท: ผู้สร้างเป็นเจ้าของหลัก
          (a.action == 'create' && a.targetUid == request.auth.uid && a.toRole == 'owner' && before == 'none'
            && !exists(coPath(co)) && getAfter(coPath(co)).data.ownerId == request.auth.uid)
          // ตอบรับคำเชิญ: ต้องยืนยันอีเมล ได้สิทธิ์ตามที่เชิญเท่านั้น และต้องลบคำเชิญใน batch เดียวกัน
          // (คำเชิญใช้ได้ครั้งเดียว คนที่ถูกนำออกจะกลับเข้ามาด้วยคำเชิญเดิมไม่ได้)
          || (a.action == 'join' && a.targetUid == request.auth.uid && before in ['none', 'removed'] && verified()
            && exists(invitePath(co)) && !existsAfter(invitePath(co)) && get(invitePath(co)).data.role == a.toRole
            && get(invitePath(co)).data.invitedByUid == a.grantedBy)
          // เจ้าของเปลี่ยนสิทธิ์/นำออก สมาชิกคนอื่นที่ไม่ใช่เจ้าของหลัก
          || (a.action in ['role', 'remove'] && isOwner(co) && a.targetUid != request.auth.uid
            && a.targetUid != primaryOwner(co) && before in roles()
            && (a.action == 'remove' ? a.toRole == 'removed' : a.toRole in roles()))
          // เจ้าของหลักโอนสิทธิ์ให้สมาชิกอื่น (ผู้รับเป็น owner และ ownerId เปลี่ยนใน batch เดียวกัน)
          || (a.action == 'transfer' && request.auth.uid == primaryOwner(co) && a.targetUid != request.auth.uid
            && before in roles() && a.toRole == 'owner' && getAfter(coPath(co)).data.ownerId == a.targetUid)
        );
    }

    match /companies/{co} {
      allow get: if isMember(co);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if
        // โอนสิทธิ์เจ้าของหลัก: เฉพาะเจ้าของหลักปัจจุบัน และต้องมี audit 'transfer' ของผู้รับใน batch เดียวกัน
        (signedIn() && request.auth.uid == resource.data.ownerId && changed().hasOnly(['ownerId'])
          && request.resource.data.ownerId in resource.data.memberIds
          && getAfter(auditPath(co, getAfter(memberOf(co, request.resource.data.ownerId)).data.auditId)).data.action == 'transfer')
        // เจ้าของแก้ข้อมูลบริษัทได้ แต่ห้ามเปลี่ยน ownerId และห้ามเอาเจ้าของหลักออกจาก memberIds
        || (isOwner(co) && request.resource.data.ownerId == resource.data.ownerId
          && resource.data.ownerId in request.resource.data.memberIds)
        // ผู้ได้รับเชิญเพิ่มตัวเองเข้า memberIds พร้อมกับ member doc ใน batch เดียวกัน
        || (signedIn() && !isMember(co) && changed().hasOnly(['memberIds'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && getAfter(memberOf(co, request.auth.uid)).data.role in roles());
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /members/{uid} {
        allow read: if isMember(co) || (signedIn() && uid == request.auth.uid);
        // ทุกการเขียนต้องอ้างถึง audit entry ใหม่ที่สร้างใน batch เดียวกัน (validAudit ตรวจความถูกต้อง)
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['role', 'email', 'addedAt', 'auditId'])
          && request.resource.data.role in ['owner', 'editor', 'viewer', 'removed']
          && (resource == null
            ? (uid == request.auth.uid && request.resource.data.email == myEmail())
            : (request.resource.data.email == resource.data.email && request.resource.data.auditId != resource.data.get('auditId', '')))
          && !exists(auditPath(co, request.resource.data.auditId))
          && existsAfter(auditPath(co, request.resource.data.auditId));
        allow delete: if false; // นำออกด้วยการตั้ง role เป็น 'removed' เพื่อให้มี audit
      }

      match /audit/{id} {
        allow read: if isOwner(co);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['action', 'actorUid', 'actorEmail', 'targetUid', 'targetEmail', 'fromRole', 'toRole', 'grantedBy', 'fromDate', 'toDate', 'branchCode', 'branchUsed', 'at'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorEmail == myEmail()
          && request.resource.data.at == request.time
          && (request.resource.data.action in ['period_lock', 'period_unlock'] ? validLockAudit(co, id, request.resource.data)
            : request.resource.data.action == 'branch_delete' ? validBranchDeleteAudit(co, id, request.resource.data)
            : validAudit(co, id, request.resource.data));
        allow update, delete: if false;
      }

      match /branches/{code} {
        allow read: if isMember(co);
        allow create: if canEdit(co) && code.matches('^[0-9]{5}$') && code != '00000'
          && request.resource.data.keys().hasOnly(branchFields())
          && request.resource.data.code == code && request.resource.data.createdAt is int
          && request.resource.data.get('used', false) is bool;
        // แก้ชื่อ/ที่อยู่/โทร/สถานะได้; รหัสและ createdAt เปลี่ยนไม่ได้; used ยกเลิกไม่ได้
        allow update: if canEdit(co)
          && request.resource.data.keys().hasOnly(branchFields())
          && request.resource.data.code == resource.data.code && request.resource.data.createdAt == resource.data.createdAt
          && (resource.data.get('used', false) == false || request.resource.data.get('used', false) == true);
        allow delete: if canEdit(co)
          && !exists(auditPath(co, 'bdel_' + code + '_' + string(resource.data.createdAt)))
          && existsAfter(auditPath(co, 'bdel_' + code + '_' + string(resource.data.createdAt)));
      }

      match /{coll}/{id} {
        allow read: if !(coll in ['members', 'audit']) && isMember(co);
        allow write: if !(coll in ['members', 'audit', 'branches']) && canEdit(co)
          && (!touchesLegal(coll, id) || isOwner(co))
          && (!lockChanged(coll, id) || lockWriteOk(co))
          && (coll != 'documents' || request.method == 'delete' || docBranchOk(co))
          && periodOk(co, coll);
      }
    }

    match /invites/{id} {
      allow read: if signedIn() && (resource.data.email == myEmail() || isOwner(resource.data.coId));
      allow create: if signedIn() && isOwner(request.resource.data.coId)
        && id == request.resource.data.coId + '__' + request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.invitedByUid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.email == myEmail() || isOwner(resource.data.coId));
    }
  }
}
