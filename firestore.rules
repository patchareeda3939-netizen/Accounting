rules_version = '2';
// PSMacc: ข้อมูลแยกตามบริษัท สิทธิ์ 3 ระดับ owner (เจ้าของ) / editor (ผู้แก้ไข) / viewer (ผู้ดู)
//   companies/{co}                  ชื่อบริษัท, ownerId, memberIds (ใช้ค้นบริษัทของผู้ใช้)
//   companies/{co}/members/{uid}    { role, email }
//   companies/{co}/{collection}/{id} ข้อมูลบัญชี (documents, contacts, accounts, settings, ...)
//   invites/{co}__{email}           คำเชิญที่ยังไม่ตอบรับ
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function companyPath(co) { return /databases/$(database)/documents/companies/$(co); }
    function memberPath(co) { return /databases/$(database)/documents/companies/$(co)/members/$(request.auth.uid); }
    function invitePath(co) { return /databases/$(database)/documents/invites/$(co + '__' + myEmail()); }
    function isMember(co) { return signedIn() && exists(memberPath(co)); }
    function role(co) { return get(memberPath(co)).data.role; }
    function canEdit(co) { return isMember(co) && role(co) in ['owner', 'editor']; }
    function isOwner(co) { return isMember(co) && role(co) == 'owner'; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return request.auth.token.email_verified == true; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /companies/{co} {
      allow get: if isMember(co);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if
        // เจ้าของแก้ได้ทุกอย่าง ยกเว้นเปลี่ยน ownerId
        (isOwner(co) && request.resource.data.ownerId == resource.data.ownerId)
        // ผู้แก้ไขเปลี่ยนได้เฉพาะชื่อและเลขผู้เสียภาษี (sync จากหน้าตั้งค่า)
        || (canEdit(co) && changed().hasOnly(['name', 'taxId']))
        // ผู้ได้รับเชิญเพิ่มตัวเองเข้า memberIds ได้ พร้อมกับสร้าง member doc ใน batch เดียวกัน
        || (signedIn() && !isMember(co) && changed().hasOnly(['memberIds'])
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.auth.uid in request.resource.data.memberIds
            && existsAfter(memberPath(co)));
      allow delete: if isOwner(co);

      match /members/{uid} {
        allow read: if isMember(co);
        allow create: if signedIn() && uid == request.auth.uid && (
            // ผู้สร้างบริษัทเป็นเจ้าของ (สร้างพร้อมบริษัทใน batch เดียวกัน)
            (request.resource.data.role == 'owner' && !exists(companyPath(co))
              && getAfter(companyPath(co)).data.ownerId == request.auth.uid)
            // ตอบรับคำเชิญ: ต้องยืนยันอีเมลแล้ว และได้สิทธิ์ตามที่เชิญเท่านั้น
            || (verified() && exists(invitePath(co))
              && get(invitePath(co)).data.role == request.resource.data.role));
        // เจ้าของจัดการสิทธิ์ของคนอื่นได้ แต่แก้/ลบสิทธิ์ของตัวเองไม่ได้ (กันบริษัทไม่มีเจ้าของ)
        allow update: if isOwner(co) && uid != request.auth.uid
          && request.resource.data.role in ['owner', 'editor', 'viewer'];
        allow delete: if isOwner(co) && uid != request.auth.uid;
      }

      match /{coll}/{id} {
        allow read: if coll != 'members' && isMember(co);
        allow write: if coll != 'members' && canEdit(co);
      }
    }

    match /invites/{id} {
      allow read: if signedIn() && (resource.data.email == myEmail() || isOwner(resource.data.coId));
      allow create: if signedIn() && isOwner(request.resource.data.coId)
        && id == request.resource.data.coId + '__' + request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role in ['editor', 'viewer'];
      allow delete: if signedIn() && (resource.data.email == myEmail() || isOwner(resource.data.coId));
    }
  }
}
